# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GOOGLE_CLIENT_ID: Obtained from Google Cloud Console for OAuth.
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Add an Authorized Redirect URI: https://<YOUR_APP_URL>/auth/callback
#    (e.g., https://ais-dev-wz2mapm3b7mykl4vwdwknj-514536930719.asia-southeast1.run.app/auth/callback)
VITE_GOOGLE_CLIENT_ID=

# GOOGLE_CLIENT_ID: Same as above, used server-side.
GOOGLE_CLIENT_ID=

# GOOGLE_CLIENT_SECRET: Obtained from Google Cloud Console for OAuth.
GOOGLE_CLIENT_SECRET=

# APP_URL: Optional. The base URL of your app (e.g. https://my-app.run.app). 
# If not set, the server will try to detect it from the request.
APP_URL=

# SESSION_SECRET: For express-session.
SESSION_SECRET=

# DATABASE_URL: For Cloud SQL access (Drizzle).
DATABASE_URL=
