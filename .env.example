# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_CLIENT_ID: Obtained from Google Cloud Console for OAuth.
GOOGLE_CLIENT_ID=

# GOOGLE_CLIENT_SECRET: Obtained from Google Cloud Console for OAuth.
GOOGLE_CLIENT_SECRET=

# SESSION_SECRET: For express-session.
SESSION_SECRET=

# DATABASE_URL: For Cloud SQL access (Drizzle).
DATABASE_URL=
